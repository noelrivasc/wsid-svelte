{
  "name": "wsid-svelte",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && pnpm build:cli",
    "build:cli": "esbuild src/cli/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=build/cli.mjs --external:better-sqlite3 --external:kysely --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "cli": "tsx --env-file-if-exists=.env src/cli/index.ts",
    "cli:docker": "docker compose exec app node /app/build/cli.mjs",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "migrate:docker": "pnpm cli:docker migrate",
    "dev:docker": "docker compose --profile dev up --build",
    "dev:docker:down": "docker compose --profile dev down",
    "mail:docker": "docker compose --profile dev up mailpit -d",
    "mail:docker:down": "docker compose --profile dev down mailpit",
    "test:unit": "vitest",
    "test": "vitest --run; echo '\\nNote: on a cold Storybook cache, the first run may report errors from flowbite-svelte <Label> (Cannot read properties of null reading nodes) in form stories. The pre-bundle stabilises on a second pass — re-run `pnpm test` to confirm.'",
    "docs": "echo 'Docs at http://localhost:8081' && python3 -m http.server 8081 --directory docs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.2",
    "@eslint/compat": "^2.0.4",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/addon-vitest": "^10.3.6",
    "@storybook/sveltekit": "^10.3.6",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.0",
    "@vitest/browser-playwright": "^4.1.3",
    "@vitest/coverage-v8": "^4.1.3",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.3.6",
    "eslint-plugin-svelte": "^3.17.0",
    "flowbite-svelte": "^1.33.1",
    "flowbite-svelte-icons": "^3.1.0",
    "globals": "^17.4.0",
    "nodemailer": "^8.0.7",
    "playwright": "^1.59.1",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "storybook": "^10.3.6",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.7",
    "vitest": "^4.1.3",
    "vitest-browser-svelte": "^2.1.0"
  },
  "dependencies": {
    "better-auth": "^1.6.11",
    "better-sqlite3": "^12.9.0",
    "citty": "^0.2.2",
    "kysely": "^0.28.17",
    "zod": "^4.4.3"
  }
}
