# SvelteKit / app
ORIGIN=https://wsid.noelr.dev
DATABASE_PATH=/app/data/app.db

# Traefik basic auth for logs.* and metrics.* subdomains.
# Generate with: htpasswd -nbB <user> <pass> | sed -e 's/\$/\$\$/g'
# Note: $ chars must be doubled ($$) so docker-compose doesn't interpolate them.
ADMIN_BASIC_AUTH=
