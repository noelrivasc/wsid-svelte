# SvelteKit / app
# Local dev (Docker): http://localhost:3000  |  Prod: https://wsid.noelr.dev
ORIGIN=http://localhost:3000
DATABASE_PATH=/app/data/app.db

# Traefik basic auth for logs.* and metrics.* subdomains.
# Generate with: htpasswd -nbB <user> <pass> | sed -e 's/\$/\$\$/g'
# Note: $ chars must be doubled ($$) so docker-compose doesn't interpolate them.
ADMIN_BASIC_AUTH=

# better-auth
# Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# SMTP — use service name `mailpit` from the app container; `localhost` from the host.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@wsid.local
